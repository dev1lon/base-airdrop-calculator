# Render backend only: used for Base RPC contract reads.
ALCHEMY_RPC=

# Vercel frontend only: point this to the Render backend base URL or full /api/check/ URL.
# Example: https://your-render-service.onrender.com
CHECK_API_URL=

# Optional: set the same value on Vercel and Render.
# Vercel sends it to Render; Render rejects direct requests without it.
CHECK_API_SECRET=
